# Frontend Environment Variables
NEXT_PUBLIC_API_URL=https://your-worker.your-subdomain.workers.dev
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id

# Cloudflare Workers Environment Variables (set via wrangler secret put)
# JWT_SECRET=your-jwt-secret-256-bit
# GITHUB_CLIENT_SECRET=your_github_client_secret
# ENCRYPTION_KEY=your-encryption-key-256-bit
# WEBHOOK_SECRET=your-webhook-secret

# KV Namespace IDs (set in wrangler.toml after creating namespaces)
# ONBOARDING_KV_ID=your-kv-namespace-id
# SECRETS_KV_ID=your-secrets-kv-namespace-id

# Optional: For development
NODE_ENV=development